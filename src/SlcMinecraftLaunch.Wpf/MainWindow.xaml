<Window x:Class="SlcMinecraftLaunch.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SlcMinecraftLaunch.Wpf.ViewModels"
        xmlns:views="clr-namespace:SlcMinecraftLaunch.Wpf.Views"
        xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters"
        Title="{DynamicResource App.Title}"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        Background="{StaticResource Brush.Surface}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
      <views:VersionsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadLoaderViewModel}">
      <views:DownloadLoaderView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:JavaViewModel}">
      <views:JavaView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModsViewModel}">
      <views:ModsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CrashViewModel}">
      <views:CrashView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <Style x:Key="NavigationButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#C7D7E1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="10,3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#234558" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="{StaticResource Brush.Sidebar}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="22,26,18,22">
          <TextBlock Text="SLC"
                     Foreground="White"
                     FontSize="29"
                     FontWeight="Bold" />
          <TextBlock Text="{DynamicResource App.Subtitle}"
                     Foreground="#8FB0C3"
                     FontSize="12" />
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource NavigationButtonStyle}"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="18"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Text="{Binding LabelKey, Converter={StaticResource Key}}"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             FontSize="15" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2"
                Margin="16,16,16,22"
                Padding="14"
                CornerRadius="12"
                Background="#1D3B4D">
          <StackPanel>
            <TextBlock Text="{DynamicResource Navigation.Account}"
                       Foreground="#8FB0C3"
                       FontSize="11" />
            <TextBlock Margin="0,5,0,0"
                       Text="{Binding AccountStatusKey, Converter={StaticResource Key}}"
                       Foreground="White"
                       FontSize="13"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ContentControl Grid.Column="1"
                    Margin="28,22,28,24"
                    Content="{Binding CurrentPage}" />
  </Grid>
</Window>

