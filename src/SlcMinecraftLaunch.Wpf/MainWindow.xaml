<Window x:Class="SlcMinecraftLaunch.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SlcMinecraftLaunch.Wpf.ViewModels"
        xmlns:views="clr-namespace:SlcMinecraftLaunch.Wpf.Views"
        xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters"
        Title="{DynamicResource App.Title}"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        AutomationProperties.Name="{DynamicResource App.Title}"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.DirectionalNavigation="Contained"
        Background="{DynamicResource Brush.Surface}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
      <views:VersionsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadLoaderViewModel}">
      <views:DownloadLoaderView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:JavaViewModel}">
      <views:JavaView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModsViewModel}">
      <views:ModsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CrashViewModel}">
      <views:CrashView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <Style x:Key="NavigationButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="10,3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="10"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SidebarHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="{DynamicResource Brush.Sidebar}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="22,26,18,22">
          <TextBlock Text="SLC"
                     Foreground="{DynamicResource Brush.SidebarText}"
                     FontSize="29"
                     FontWeight="Bold" />
          <TextBlock Text="{DynamicResource App.Subtitle}"
                     Foreground="{DynamicResource Brush.SidebarMuted}"
                     FontSize="12" />
        </StackPanel>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding NavigationItems}"
                      KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource NavigationButtonStyle}"
                      AutomationProperties.Name="{Binding LabelKey, Converter={StaticResource Key}}"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="18"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Text="{Binding LabelKey, Converter={StaticResource Key}}"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             FontSize="15" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Grid>
    </Border>

    <Grid Grid.Column="1" ClipToBounds="True">
      <Grid IsHitTestVisible="False"
            Visibility="{Binding Preferences.Current.BackgroundEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Ellipse Width="520"
                 Height="520"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-250,-150,0">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#553DC9BF" Offset="0" />
              <GradientStop Color="#003DC9BF" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="420"
                 Height="420"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-190,0,0,-220">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#4478A9E8" Offset="0" />
              <GradientStop Color="#0078A9E8" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Rectangle Opacity="0.22">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#00000000" Offset="0" />
              <GradientStop Color="#220B8F87" Offset="0.5" />
              <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <ContentControl x:Name="PageHost"
                      Margin="28,22,28,24"
                      Content="{Binding CurrentPage}"
                      AutomationProperties.Name="{Binding CurrentPage.TitleKey, Converter={StaticResource Key}}"
                      Opacity="1">
        <ContentControl.RenderTransform>
          <TranslateTransform />
        </ContentControl.RenderTransform>
      </ContentControl>
    </Grid>
  </Grid>
</Window>
