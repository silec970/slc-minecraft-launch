<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="App.Title">SLC Minecraft Launcher</sys:String>
  <sys:String x:Key="Home.Title">Welcome to SLC Minecraft Launcher</sys:String>
  <sys:String x:Key="Home.Description">Version, download, mod, and crash tools will be connected in later modules.</sys:String>
  <sys:String x:Key="Home.InstalledVersions">Installed versions</sys:String>
  <sys:String x:Key="Crash.Category.Mod.Title">A mod likely caused the crash</sys:String>
  <sys:String x:Key="Crash.Category.Mod.Suggestion">Disable recently installed mods and verify dependencies and loader versions.</sys:String>
  <sys:String x:Key="Crash.Category.Memory.Title">Insufficient Java memory</sys:String>
  <sys:String x:Key="Crash.Category.Memory.Suggestion">Increase maximum memory, close memory-heavy apps, and check for mod leaks.</sys:String>
  <sys:String x:Key="Crash.Category.Java.Title">Incompatible Java runtime</sys:String>
  <sys:String x:Key="Crash.Category.Java.Suggestion">Select Java for the game and loader version; avoid Java 25 for old Forge.</sys:String>
  <sys:String x:Key="Crash.Category.Gpu.Title">GPU or OpenGL failure</sys:String>
  <sys:String x:Key="Crash.Category.Gpu.Suggestion">Update the graphics driver and retry without shaders or with lower settings.</sys:String>
  <sys:String x:Key="Crash.Category.Loader.Title">Mod loader failed to start</sys:String>
  <sys:String x:Key="Crash.Category.Loader.Suggestion">Reinstall the loader and verify Forge/NeoForge/OptiFine compatibility.</sys:String>
  <sys:String x:Key="Crash.Category.Configuration.Title">Configuration or file access error</sys:String>
  <sys:String x:Key="Crash.Category.Configuration.Suggestion">Check the install path, permissions, and files locked by another process.</sys:String>
  <sys:String x:Key="Crash.Category.Other.Title">Another startup problem was detected</sys:String>
  <sys:String x:Key="Crash.Category.Other.Suggestion">Review the complete crash-report and latest.log stack traces.</sys:String>
  <sys:String x:Key="Mods.Installed">Mod installed successfully</sys:String>
  <sys:String x:Key="Mods.Downloading">Downloading mod</sys:String>
  <sys:String x:Key="Mods.Downloaded">Mod download completed</sys:String>
  <sys:String x:Key="Mods.InvalidPackage">The selected file is not a valid mod JAR</sys:String>
  <sys:String x:Key="Mods.NoCompatibleFile">No mod file matches the current game version and loader</sys:String>
  <sys:String x:Key="Mods.CurseForgeKeyMissing">No CurseForge API key is configured; only Modrinth results are available</sys:String>
  <sys:String x:Key="Mods.Conflict.Duplicate">Duplicate mod IDs were detected</sys:String>
  <sys:String x:Key="Mods.Conflict.MissingDependency">A required mod dependency is missing</sys:String>
  <sys:String x:Key="Mods.Conflict.OptifineSodium">OptiFine and Sodium may be incompatible; enable only one</sys:String>
</ResourceDictionary>

