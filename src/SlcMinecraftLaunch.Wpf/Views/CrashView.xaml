<UserControl x:Class="SlcMinecraftLaunch.Wpf.Views.CrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters">
  <UserControl.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding TitleKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageDescriptionStyle}" />

      <Border Style="{StaticResource CardStyle}">
        <WrapPanel>
          <ComboBox ItemsSource="{Binding Versions}"
                    SelectedItem="{Binding SelectedVersion}"
                    MinWidth="260" />
          <Button Content="{DynamicResource Crash.Analyze}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AnalyzeCommand}" />
        </WrapPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Crash.History.Title}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <ListBox Margin="0,10,0,0"
                   MaxHeight="240"
                   ItemsSource="{Binding History}"
                   SelectedItem="{Binding SelectedHistory}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinWidth="680">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DisplayTime}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Report.VersionId}"
                             Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding SummaryKey, Converter={StaticResource Key}}"
                             Foreground="{StaticResource Brush.Muted}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="{DynamicResource Crash.History.OpenLog}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding HasSelectedHistory}"
                    Click="OpenCrashLog_Click" />
            <Button Content="{DynamicResource Crash.History.Delete}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding HasSelectedHistory}"
                    Click="DeleteCrashReport_Click" />
          </WrapPanel>
          <TextBlock Margin="0,6,0,0"
                     Text="{DynamicResource Crash.History.Retention}"
                     Foreground="{StaticResource Brush.Muted}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Insights}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{Binding MessageKey, Converter={StaticResource Key}}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SuggestionKey, Converter={StaticResource Key}}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Muted}" />
                <TextBlock Text="{Binding CauseCode}"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{StaticResource Brush.AccentDark}" />
                <TextBlock Text="{Binding AttributionKey, Converter={StaticResource Key}}"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}" />
                <ItemsControl ItemsSource="{Binding AffectedModFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 Margin="0,4,0,0"
                                 Foreground="{StaticResource Brush.Muted}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ProgressBar Value="{Binding Progress}"
                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding StatusKey, Converter={StaticResource Key}}" />
      <TextBlock Text="{Binding ErrorDetail}" Foreground="#B94A48" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

