<UserControl x:Class="SlcMinecraftLaunch.Wpf.Views.CrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters">
  <UserControl.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding TitleKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageDescriptionStyle}" />

      <Border Style="{StaticResource CardStyle}">
        <WrapPanel>
          <ComboBox ItemsSource="{Binding Versions}"
                    SelectedItem="{Binding SelectedVersion}"
                    MinWidth="260" />
          <Button Content="{DynamicResource Crash.Analyze}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AnalyzeCommand}" />
        </WrapPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Insights}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{Binding MessageKey, Converter={StaticResource Key}}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SuggestionKey, Converter={StaticResource Key}}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Muted}" />
                <TextBlock Text="{Binding CauseCode}"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{StaticResource Brush.AccentDark}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ProgressBar Value="{Binding Progress}"
                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding StatusKey, Converter={StaticResource Key}}" />
      <TextBlock Text="{Binding ErrorDetail}" Foreground="#B94A48" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

