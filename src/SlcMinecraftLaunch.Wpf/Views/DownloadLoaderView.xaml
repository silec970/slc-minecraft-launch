<UserControl x:Class="SlcMinecraftLaunch.Wpf.Views.DownloadLoaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters">
  <UserControl.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
    <conv:LoaderKindConverter x:Key="LoaderKindKey" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding TitleKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageDescriptionStyle}" />

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Download.VanillaCatalog}" FontWeight="SemiBold" />
          <WrapPanel Margin="0,10,0,0">
            <ComboBox ItemsSource="{Binding CatalogVersions}"
                      SelectedItem="{Binding SelectedCatalogVersion}"
                      AutomationProperties.Name="{DynamicResource Download.VanillaCatalog}"
                      MinWidth="260">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                    <TextBlock Margin="8,0,0,0"
                               Text="{Binding Type}"
                               Foreground="{DynamicResource Brush.Muted}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="{DynamicResource Download.ShowSnapshots}"
                      IsChecked="{Binding ShowSnapshots}"
                      AutomationProperties.Name="{DynamicResource Download.ShowSnapshots}"
                      VerticalAlignment="Center"
                      Margin="0,0,14,10" />
            <Button Content="{DynamicResource Download.InstallVanilla}"
                    AutomationProperties.Name="{DynamicResource Download.InstallVanilla}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding CanInstallVanilla}"
                    Command="{Binding InstallVanillaCommand}" />
          </WrapPanel>
          <TextBlock Text="{DynamicResource Download.LoaderSection}"
                     Margin="0,8,0,0"
                     Foreground="{DynamicResource Brush.Muted}" />
          <TextBlock Text="{DynamicResource Download.LiteLoaderUnsupported}"
                     Margin="0,8,0,0"
                     Foreground="{DynamicResource Brush.Muted}"
                     TextWrapping="Wrap" />
          <WrapPanel Margin="0,10,0,0">
            <ComboBox ItemsSource="{Binding LoaderKinds}"
                      SelectedItem="{Binding SelectedLoaderKind}"
                      AutomationProperties.Name="{DynamicResource Download.LoaderSection}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource LoaderKindKey}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{DynamicResource Download.ResolveLoader}"
                    AutomationProperties.Name="{DynamicResource Download.ResolveLoader}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ResolveLoaderVersionsCommand}" />
          </WrapPanel>
          <ComboBox Margin="0,8,0,0"
                    ItemsSource="{Binding LoaderVersions}"
                    SelectedItem="{Binding SelectedLoaderVersion}"
                    AutomationProperties.Name="{DynamicResource Instances.LoaderVersion}"
                    DisplayMemberPath="DisplayName" />
          <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{DynamicResource Java.ManualPath}"
                   ToolTip="{DynamicResource Download.JavaPathHint}" />
          <TextBox Text="{Binding CustomVersionId, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{DynamicResource Instances.Id}"
                   ToolTip="{DynamicResource Download.CustomVersionIdHint}" />
          <WrapPanel>
            <Button Content="{DynamicResource Download.InstallLoader}"
                    AutomationProperties.Name="{DynamicResource Download.InstallLoader}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding InstallLoaderCommand}" />
            <Button Content="{DynamicResource Download.CompleteResources}"
                    AutomationProperties.Name="{DynamicResource Download.CompleteResources}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding CanCompleteDownload}"
                    Command="{Binding CompleteResourcesCommand}" />
          </WrapPanel>
          <TextBlock Margin="0,14,0,0"
                     Text="{Binding InstalledVersionId}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Accent}" />
          <Grid Margin="0,12,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <ProgressBar Value="{Binding Progress}"
                         AutomationProperties.Name="{DynamicResource Download.OperationProgress}" />
            <TextBlock Grid.Column="1"
                       Margin="10,10,0,8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding Progress, StringFormat={}{0:P0}}" />
          </Grid>
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding StatusKey, Converter={StaticResource Key}}"
                     Foreground="{DynamicResource Brush.Muted}" />
          <TextBlock Text="{Binding ErrorDetail}"
                     Foreground="{DynamicResource Brush.Danger}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Download.Tasks}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <ListBox Margin="0,10,0,0"
                   MaxHeight="230"
                   ItemsSource="{Binding DownloadTasks}"
                   AutomationProperties.Name="{DynamicResource Download.Tasks}"
                   SelectedItem="{Binding SelectedDownloadTask}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinWidth="680">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding VersionId}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding MessageKey, Converter={StaticResource Key}}"
                             Foreground="{DynamicResource Brush.Muted}" />
                  <ProgressBar Grid.Column="2"
                               Minimum="0"
                               Maximum="1"
                               Value="{Binding Progress}" />
                  <TextBlock Grid.Column="3"
                             Margin="10,0,0,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Text="{Binding Progress, StringFormat={}{0:P0}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="{DynamicResource Download.PauseTask}"
                    AutomationProperties.Name="{DynamicResource Download.PauseTask}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding CanPauseDownload}"
                    Command="{Binding PauseDownloadCommand}" />
            <Button Content="{DynamicResource Download.ResumeTask}"
                    AutomationProperties.Name="{DynamicResource Download.ResumeTask}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding CanRetryDownload}"
                    Command="{Binding ResumeDownloadCommand}"
                    CommandParameter="{Binding SelectedDownloadTask.TaskId}" />
            <Button Content="{DynamicResource Download.RetryFailed}"
                    AutomationProperties.Name="{DynamicResource Download.RetryFailed}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding CanRetryDownload}"
                    Command="{Binding RetryFailedCommand}"
                    CommandParameter="{Binding SelectedDownloadTask.TaskId}" />
            <Button Content="{DynamicResource Download.DeleteTask}"
                    AutomationProperties.Name="{DynamicResource Download.DeleteTask}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding CanDeleteDownload}"
                    Command="{Binding DeleteDownloadTaskCommand}"
                    CommandParameter="{Binding SelectedDownloadTask.TaskId}" />
          </WrapPanel>
          <TextBlock Margin="0,12,0,0"
                     Text="{DynamicResource Download.FailedFiles}"
                     FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding SelectedDownloadTask.FailedFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding TargetPath}"
                           ToolTip="{Binding ErrorDetail}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.Muted}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="0,12,0,0"
                     Text="{DynamicResource Download.Sources}"
                     FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding SelectedDownloadTask.Sources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.Muted}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
