<UserControl x:Class="SlcMinecraftLaunch.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters">
  <UserControl.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding TitleKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageDescriptionStyle}" />

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource Home.VersionCount}"
                       Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding InstalledVersionCount}"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding PrimaryVersion}"
                       FontSize="15"
                       FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Home.GameRoot}"
                       Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding RootPath}"
                       MaxWidth="620"
                       TextWrapping="Wrap"
                       FontSize="13" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Home.LaunchTitle}"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <ComboBox ItemsSource="{Binding InstalledVersions}"
                      SelectedItem="{Binding SelectedVersion}"
                      AutomationProperties.Name="{DynamicResource Home.VersionHint}"
                      MinWidth="280" />
            <Button Content="{DynamicResource Home.Launch}"
                    AutomationProperties.Name="{DynamicResource Home.Launch}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding CanLaunch}"
                    Command="{Binding LaunchCommand}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{DynamicResource Home.CurrentPlayer}"
                       Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Margin="6,0,0,0"
                       Text="{Binding PlayerName}"
                       FontWeight="SemiBold" />
            <Button Content="{DynamicResource Home.OpenSettings}"
                    AutomationProperties.Name="{DynamicResource Home.OpenSettings}"
                    Margin="16,0,0,0"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="{DynamicResource Brush.Accent}"
                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,16">
          <StackPanel>
            <TextBlock Text="{DynamicResource Home.VersionHint}" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="{DynamicResource Home.VersionHintDetail}"
                       Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,16">
          <StackPanel>
            <TextBlock Text="{DynamicResource Home.ModHint}" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="{DynamicResource Home.ModHintDetail}"
                       Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,16">
          <StackPanel>
            <TextBlock Text="{DynamicResource Home.CrashHint}" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="{DynamicResource Home.CrashHintDetail}"
                       Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <ProgressBar Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding StatusKey, Converter={StaticResource Key}}"
                 Foreground="{DynamicResource Brush.Muted}" />
      <TextBlock Text="{Binding ErrorDetail}"
                 Foreground="{DynamicResource Brush.Danger}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
