<UserControl x:Class="SlcMinecraftLaunch.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters">
  <UserControl.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding TitleKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageDescriptionStyle}" />

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource Home.VersionCount}"
                       Foreground="{StaticResource Brush.Muted}" />
            <TextBlock Text="{Binding InstalledVersionCount}"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="{StaticResource Brush.Accent}" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding PrimaryVersion}"
                       FontSize="15"
                       FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Home.GameRoot}"
                       Foreground="{StaticResource Brush.Muted}" />
            <TextBlock Text="{Binding RootPath}"
                       MaxWidth="620"
                       TextWrapping="Wrap"
                       FontSize="13" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}"
              Background="#FFF7E8"
              BorderBrush="#F1D5A5">
        <StackPanel>
          <TextBlock Text="{DynamicResource Home.Account}"
                     FontSize="17"
                     FontWeight="SemiBold" />
          <TextBlock Margin="0,7,0,0"
                     Text="{DynamicResource Home.MicrosoftAccountRequired}"
                     Foreground="{StaticResource Brush.Muted}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,16">
          <StackPanel>
            <TextBlock Text="{DynamicResource Home.VersionHint}" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="{DynamicResource Home.VersionHintDetail}"
                       Foreground="{StaticResource Brush.Muted}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,16">
          <StackPanel>
            <TextBlock Text="{DynamicResource Home.ModHint}" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="{DynamicResource Home.ModHintDetail}"
                       Foreground="{StaticResource Brush.Muted}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,16">
          <StackPanel>
            <TextBlock Text="{DynamicResource Home.CrashHint}" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="{DynamicResource Home.CrashHintDetail}"
                       Foreground="{StaticResource Brush.Muted}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <ProgressBar Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding StatusKey, Converter={StaticResource Key}}"
                 Foreground="{StaticResource Brush.Muted}" />
      <TextBlock Text="{Binding ErrorDetail}"
                 Foreground="#B94A48"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

