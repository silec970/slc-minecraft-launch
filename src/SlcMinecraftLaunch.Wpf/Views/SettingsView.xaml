<UserControl x:Class="SlcMinecraftLaunch.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters">
  <UserControl.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding TitleKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageDescriptionStyle}" />

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Settings.GameRoot}" Foreground="{StaticResource Brush.Muted}" />
          <TextBlock Grid.Column="1" Text="{Binding GameRoot}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Margin="0,14,0,0" Text="{DynamicResource Settings.DataRoot}" Foreground="{StaticResource Brush.Muted}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Text="{Binding DataRoot}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Margin="0,14,0,0" Text="{DynamicResource Settings.Version}" Foreground="{StaticResource Brush.Muted}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" Text="{Binding LauncherVersion}" />
          <TextBlock Grid.Row="3" Margin="0,14,0,0" Text="{DynamicResource Settings.Language}" Foreground="{StaticResource Brush.Muted}" />
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,14,0,0"
                     Text="{Binding LanguageKey, Converter={StaticResource Key}}" />
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}" Background="#FFF7E8">
        <TextBlock Text="{DynamicResource Settings.AccountNote}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.Muted}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

