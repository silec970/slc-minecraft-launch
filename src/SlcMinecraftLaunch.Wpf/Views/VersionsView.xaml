<UserControl x:Class="SlcMinecraftLaunch.Wpf.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlcMinecraftLaunch.Wpf.Converters">
  <UserControl.Resources>
    <conv:ResourceKeyConverter x:Key="Key" />
    <conv:LoaderKindConverter x:Key="LoaderKindKey" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding TitleKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource Key}}"
                 Style="{StaticResource PageDescriptionStyle}" />

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{Binding NameKey, Converter={StaticResource Key}}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Instances}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Brush.Border}"
                              BorderThickness="0,0,0,1"
                              Padding="0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Button HorizontalContentAlignment="Left"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Command="{Binding DataContext.SelectInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{StaticResource Brush.Muted}" />
                            </StackPanel>
                          </Button>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding MinecraftVersion}"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource Brush.Muted}" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding PlaceholderTextKey, Converter={StaticResource Key}}"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource Brush.Muted}" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="{Binding FavoriteGlyph}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="{Binding IsolationGlyph}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding DataContext.ToggleIsolationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Instances.CreateEmpty}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Margin="0,6,0,0"
                     Text="{DynamicResource Instances.CreateEmptyHint}"
                     Foreground="{StaticResource Brush.Muted}"
                     TextWrapping="Wrap" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="{DynamicResource Instances.Id}" />
              <TextBox Text="{Binding NewInstanceId, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="{DynamicResource Instances.Name}" />
              <TextBox Text="{Binding NewInstanceName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="{DynamicResource Instances.MinecraftVersion}" />
              <TextBox Text="{Binding NewMinecraftVersion, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0">
              <TextBlock Text="{DynamicResource Instances.Loader}" />
              <ComboBox ItemsSource="{Binding LoaderKinds}"
                        SelectedItem="{Binding NewLoaderKind}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource LoaderKindKey}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="8,0,0,0">
              <TextBlock Text="{DynamicResource Instances.LoaderVersion}" />
              <TextBox Text="{Binding NewLoaderVersion, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
          <Button Content="{DynamicResource Instances.Create}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Command="{Binding CreateEmptyCommand}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel IsEnabled="{Binding HasSelectedInstance}">
          <TextBlock Text="{DynamicResource Instances.Settings}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding SelectedInstance.Id}"
                     Foreground="{StaticResource Brush.Accent}" />
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding SelectedInstance.PlaceholderTextKey, Converter={StaticResource Key}}"
                     Foreground="{StaticResource Brush.Muted}" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="{DynamicResource Instances.Name}" />
              <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="{DynamicResource Instances.JavaPath}" />
              <TextBox Text="{Binding JavaExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
              <TextBlock Text="{DynamicResource Instances.MinMemory}" />
              <TextBox Text="{Binding MinimumMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0">
              <TextBlock Text="{DynamicResource Instances.MaxMemory}" />
              <TextBox Text="{Binding MaximumMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="6,0">
              <TextBlock Text="{DynamicResource Instances.JavaMajor}" />
              <TextBox Text="{Binding SuggestedJavaMajor, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <CheckBox Grid.Column="3"
                      Content="{DynamicResource Instances.Fullscreen}"
                      IsChecked="{Binding Fullscreen}"
                      VerticalAlignment="Bottom"
                      Margin="6,0,0,8" />
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="{DynamicResource Instances.WindowWidth}" />
              <TextBox Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="{DynamicResource Instances.WindowHeight}" />
              <TextBox Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="{DynamicResource Instances.JvmArguments}" />
              <TextBox MinHeight="70"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Text="{Binding JvmArgumentsText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="{DynamicResource Instances.ArgumentsHint}"
                         Foreground="{StaticResource Brush.Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="{DynamicResource Instances.GameArguments}" />
              <TextBox MinHeight="70"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Text="{Binding GameArgumentsText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="{DynamicResource Instances.ArgumentsHint}"
                         Foreground="{StaticResource Brush.Muted}" />
            </StackPanel>
          </Grid>
          <WrapPanel Margin="0,12,0,0">
            <Button Content="{DynamicResource Instances.Save}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveSelectedCommand}" />
            <Button Content="{DynamicResource Instances.Delete}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="DeleteInstance_Click" />
          </WrapPanel>
          <Separator Margin="0,14" />
          <TextBlock Text="{DynamicResource Instances.Copy}" FontWeight="SemiBold" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,8,0"
                     Text="{Binding CopyTargetId, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Instances.Id}" />
            <TextBox Grid.Column="1"
                     Margin="8,0"
                     Text="{Binding CopyTargetName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Instances.Name}" />
            <Button Grid.Column="2"
                    Content="{DynamicResource Instances.CopyAction}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CopySelectedCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Instances.Transfer}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Margin="0,6,0,0"
                     Text="{DynamicResource Instances.TransferHint}"
                     Foreground="{StaticResource Brush.Muted}"
                     TextWrapping="Wrap" />
          <WrapPanel Margin="0,10,0,0">
            <CheckBox Content="{DynamicResource Instances.IncludeSaves}"
                      IsChecked="{Binding IncludeSaves}"
                      Margin="0,0,20,8" />
            <CheckBox Content="{DynamicResource Instances.IncludeScreenshots}"
                      IsChecked="{Binding IncludeScreenshots}"
                      Margin="0,0,20,8" />
            <CheckBox Content="{DynamicResource Instances.IncludeServers}"
                      IsChecked="{Binding IncludeServersFile}"
                      Margin="0,0,20,8" />
            <CheckBox Content="{DynamicResource Instances.IncludeLogs}"
                      IsChecked="{Binding IncludeLogs}"
                      Margin="0,0,20,8" />
          </WrapPanel>
          <WrapPanel>
            <Button Content="{DynamicResource Instances.Export}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding HasSelectedInstance}"
                    Click="ExportInstance_Click" />
            <Button Content="{DynamicResource Instances.Backup}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding HasSelectedInstance}"
                    Click="BackupInstance_Click" />
            <Button Content="{DynamicResource Instances.Import}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ImportInstance_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <ProgressBar Value="{Binding Progress}"
                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding StatusKey, Converter={StaticResource Key}}"
                 Foreground="{StaticResource Brush.Muted}" />
      <TextBlock Text="{Binding ErrorDetail}" Foreground="#B94A48" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
